let currentLang = 'de';
const REQUIRED_INCIDENT_ID = 'F01283425/2026';
let currentBalance = 167342.07;
let sessionName = '';
let transactions = [
  { counterparty: 'European Settlement AG', ref: 'INVOICE-2024-8841', isToday: true, timeStr: '09:15', type: 'SCT Inst', amount: '+167,342.07', isPositive: true },
  { counterparty: 'Deutsche Bundesbank Clearing', ref: 'FEE-Q3-CLEARING', isYesterday: true, timeStr: '', type: 'Debit', amount: '-12.50', isPositive: false }
];

function setLanguage(lang) {
  currentLang = lang;
  document.documentElement.lang = lang;
  document.getElementById('langDE').classList.toggle('active', lang === 'de');
  document.getElementById('langEN').classList.toggle('active', lang === 'en');
  document.getElementById('langFR').classList.toggle('active', lang === 'fr');

  const dict = translations[lang];

  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    if (dict[key]) el.innerHTML = dict[key];
  });

  document.querySelectorAll('[data-i18n-ph]').forEach(el => {
    const key = el.getAttribute('data-i18n-ph');
    if (dict[key]) el.placeholder = dict[key];
  });

  document.querySelectorAll('[data-i18n-title]').forEach(el => {
    const key = el.getAttribute('data-i18n-title');
    if (dict[key]) el.title = dict[key];
  });

  if (document.getElementById('reportDate').textContent !== '—') {
    const loc = lang === 'de' ? 'de-DE' : lang === 'fr' ? 'fr-FR' : 'en-US';
    document.getElementById('reportDate').textContent = new Date().toLocaleDateString(loc, { day: '2-digit', month: '2-digit', year: 'numeric' });
  }

  renderTransactions();
}

function setStage(n, opts) {
  ['stageAuth','stageReport','stagePortal'].forEach((id,i) => {
    document.getElementById(id).classList.toggle('hidden', i + 1 !== n);
  });
  const bs = document.getElementById('brandSTS'), bb = document.getElementById('brandBank');
  bs.classList.toggle('hidden', n === 3); bs.classList.toggle('flex', n !== 3);
  bb.classList.toggle('hidden', n !== 3); bb.classList.toggle('flex', n === 3);

  const ua = document.getElementById('headerUserArea');
  ua.classList.toggle('hidden', n === 1); ua.classList.toggle('flex', n !== 1);

  document.querySelectorAll('[data-step]').forEach(el => {
    const s = Number(el.dataset.step), on = s === n, past = s < n;
    el.classList.toggle('text-white', on);
    el.classList.toggle('text-[#576d80]', !on && !past);
    el.classList.toggle('text-[#8499ab]', past);
    const d = el.querySelector('.dot');
    d.classList.toggle('bg-[#00aeef]', on);
    d.classList.toggle('bg-[#188a58]', past);
    d.classList.toggle('bg-[#00395d]', !on && !past);
  });

  if (!opts || !opts.silent) {
    const sec = document.getElementById(n === 1 ? 'stageAuth' : n === 2 ? 'stageReport' : 'stagePortal');
    sec.classList.remove('rise'); void sec.offsetWidth; sec.classList.add('rise');
  }
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function handleLogin(e) {
  e.preventDefault();
  const rawId = document.getElementById('inputIncidentId').value.trim();
  // Очищаем # и любые пробелы вокруг слэша, чтобы принимались и 'F01283425 / 2026', и '#F01283425 / 2026'
  const normalizedId = rawId.replace(/^#/, '').replace(/\s*\/\s*/, '/').toUpperCase();
  const name = document.getElementById('inputUsername').value.trim();
  const err = document.getElementById('loginError');
  const btn = document.getElementById('submitBtn');
  const txt = document.getElementById('btnText'), ico = document.getElementById('btnIcon'), sp = document.getElementById('btnSpinner');

  if (normalizedId !== REQUIRED_INCIDENT_ID) {
    err.classList.remove('hidden');
    document.getElementById('loginErrorMsg').textContent = translations[currentLang].auth_err_id;
    return;
  }
  if (!name) return;
  err.classList.add('hidden');

  txt.textContent = translations[currentLang].auth_verifying;
  ico.classList.add('hidden'); sp.classList.remove('hidden'); btn.disabled = true;

  setTimeout(() => {
    sessionName = name;
    const formattedId = '#F01283425 / 2026';
    const loc = currentLang === 'de' ? 'de-DE' : currentLang === 'fr' ? 'fr-FR' : 'en-US';
    document.getElementById('displayHeaderUser').textContent = name;
    document.getElementById('reportUserName').textContent = name;
    document.getElementById('reportIncidentId').textContent = formattedId;
    document.getElementById('certEntity').textContent = name;
    document.getElementById('reportDate').textContent = new Date().toLocaleDateString(loc, { day: '2-digit', month: '2-digit', year: 'numeric' });

    txt.textContent = translations[currentLang].auth_submit;
    ico.classList.remove('hidden'); sp.classList.add('hidden'); btn.disabled = false;

    setStage(2);
    toast(translations[currentLang].toast_ok_auth, translations[currentLang].toast_ok_auth_sub, 'ok');
  }, 700);
}

function enterPortal() {
  const btn = document.getElementById('portalBtn'), t = document.getElementById('portalBtnText');
  const i = document.getElementById('portalBtnIcon'), s = document.getElementById('portalBtnSpinner');
  btn.disabled = true; t.textContent = translations[currentLang].report_portal_connecting; i.classList.add('hidden'); s.classList.remove('hidden');

  setTimeout(() => {
    btn.disabled = false; t.textContent = translations[currentLang].report_portal_btn; i.classList.remove('hidden'); s.classList.add('hidden');
    updateBalanceDisplays(); renderTransactions(); setStage(3);
    toast(translations[currentLang].toast_portal_open, translations[currentLang].toast_portal_open_sub, 'info');
  }, 750);
}

function logout() {
  document.getElementById('inputIncidentId').value = '';
  document.getElementById('inputUsername').value = '';
  document.getElementById('loginError').classList.add('hidden');
  closeTransferModal(); closeCertificateModal(); setStage(1);
  toast(translations[currentLang].toast_logout, translations[currentLang].toast_logout_sub, 'info');
}

function updateBalanceDisplays() {
  document.getElementById('accountBalanceDisplay').textContent = currentBalance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  document.getElementById('usdEquivDisplay').textContent = (currentBalance * 1.08).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  document.getElementById('certBalance').textContent = currentBalance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' EUR';
}

function renderTransactions() {
  const tb = document.getElementById('transactionTableBody');
  tb.innerHTML = '';
  const d = translations[currentLang];
  transactions.forEach(t => {
    let dateStr = '';
    if (t.isToday) {
      dateStr = `${d.today}, ${t.timeStr}`;
    } else if (t.isYesterday) {
      dateStr = d.yesterday;
    } else {
      dateStr = t.timeStr;
    }

    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td class="font-medium text-[#001e38]">${t.counterparty}</td>
      <td class="text-[#576d80]">${t.ref}</td>
      <td class="text-[#8499ab]">${dateStr}</td>
      <td class="text-[9.5px] tracking-[.16em] uppercase ${t.isPositive ? 'text-[#188a58] font-semibold' : 'text-[#8499ab]'}">${t.type}</td>
      <td class="text-right font-medium ${t.isPositive ? 'text-[#188a58]' : 'text-[#001e38]'}">${t.amount}</td>`;
    tb.appendChild(tr);
  });
}

function openTransferModal() {
  document.getElementById('inputRecipientName').value = sessionName || '';
  document.getElementById('inputRecipientIBAN').value = '';
  document.getElementById('inputRecipientBIC').value = '';
  document.getElementById('inputTransferAmount').value = '';
  document.getElementById('inputTransferAmount').max = currentBalance;
  document.getElementById('transferModalAlert').classList.add('hidden');
  document.getElementById('transferModal').classList.remove('hidden');
}
function closeTransferModal() { document.getElementById('transferModal').classList.add('hidden'); }
function setMaxTransferAmount() { document.getElementById('inputTransferAmount').value = currentBalance.toFixed(2); }
function openCertificateModal() { document.getElementById('certificateModal').classList.remove('hidden'); }
function closeCertificateModal() { document.getElementById('certificateModal').classList.add('hidden'); }

function handleTransferSubmit(e) {
  e.preventDefault();
  const amount = parseFloat(document.getElementById('inputTransferAmount').value) || 0;
  const recipient = document.getElementById('inputRecipientName').value.trim();
  const ref = document.getElementById('inputRemittance').value.trim();
  const alertBox = document.getElementById('transferModalAlert');

  if (amount <= 0 || amount > currentBalance) {
    alertBox.classList.remove('hidden');
    document.getElementById('transferModalAlertMsg').textContent = translations[currentLang].modal_tr_alert;
    return;
  }
  alertBox.classList.add('hidden');
  currentBalance -= amount;

  const now = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  transactions.unshift({
    counterparty: recipient, ref: ref, isToday: true, timeStr: now,
    type: amount <= 100000 ? 'SCT Inst' : 'SCT Regular',
    amount: `-${amount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`,
    isPositive: false
  });

  updateBalanceDisplays(); renderTransactions(); closeTransferModal();
  toast(translations[currentLang].toast_tx_sent, `SEPA: €${amount.toLocaleString('en-US', { minimumFractionDigits: 2 })}`, 'ok');
}

function copyToClipboard(text, label) {
  const el = document.createElement('input');
  el.value = text.replace(/\s+/g, '');
  document.body.appendChild(el); el.select(); document.execCommand('copy'); document.body.removeChild(el);
  toast(translations[currentLang].toast_copied, `${label} ${translations[currentLang].toast_copied_sub}`, 'ok');
}

function toast(title, msg, type) {
  const t = document.getElementById('toast');
  document.getElementById('toastTitle').textContent = title;
  document.getElementById('toastMsg').textContent = msg;
  t.style.borderLeftColor = type === 'ok' ? '#188a58' : type === 'err' ? '#d9383a' : '#00aeef';
  t.classList.remove('translate-x-[130%]');
  clearTimeout(window.__tt);
  window.__tt = setTimeout(() => t.classList.add('translate-x-[130%]'), 3600);
}

document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeTransferModal(); closeCertificateModal(); } });
setStage(1, { silent: true });
